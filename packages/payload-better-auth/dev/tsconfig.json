{
  "extends": "../tsconfig.json",
  "exclude": ["../src/register.internal.d.ts"],
  "include": [
    "**/*.js",
    "**/*.jsx",
    "**/*.mjs",
    "**/*.cjs",
    "**/*.ts",
    "**/*.tsx",
    "../src/**/*.ts",
    "../src/**/*.tsx",
    "next.config.mjs",
    ".next/types/**/*.ts"
  ],
  "compilerOptions": {
    "baseUrl": "./",
    "rootDir": "../",
    "moduleResolution": "bundler",
    "module": "Preserve",
    "composite": true,
    "paths": {
      "@payload-config": ["./payload.config.ts"],
      "@b3nab/payload-better-auth": ["../src/index.ts"],
      "@b3nab/payload-better-auth/client": ["../src/exports/client.ts"],
      "@b3nab/payload-better-auth/rsc": ["../src/exports/rsc.ts"],
      "@b3nab/payload-better-auth/nextjs": ["../src/exports/nextjs.ts"],
      "@/*": ["./*"]
    },
    "noEmit": true,
    "emitDeclarationOnly": false,
    "incremental": true
  }
}
